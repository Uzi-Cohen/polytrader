# Database (defaults to a local SQLite file if unset)
DATABASE_URL=sqlite:///./polytrader.db

# Optional: enables the Claude-backed research Estimator for Polymarket
# probability forecasts. Without this set, only the deterministic no-op
# estimator is available -- the system will not fabricate probabilities.
ANTHROPIC_API_KEY=

# Risk engine limits (all have sane defaults in core/config.py -- override
# here only if you want different behavior).
MAX_RISK_PER_TRADE_PCT=0.02
KELLY_FRACTION=0.35
MAX_TOTAL_EXPOSURE_PCT=0.5
MAX_MARKET_CONCENTRATION_PCT=0.08
MAX_CATEGORY_CONCENTRATION_PCT=0.25
DAILY_LOSS_PAUSE_PCT=0.05
MAX_DRAWDOWN_HALT_PCT=0.18
MIN_ADJUSTED_EDGE=0.03
KILL_SWITCH=false

# Congress mirror strategy: separate paper bankroll from the Polymarket one.
MIRROR_STARTING_BANKROLL=100000
POLYMARKET_STARTING_BANKROLL=10000

# Live trading is out of scope for this build and stays hard-disabled.
LIVE_TRADING_ENABLED=false
